<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BiomeLords</AssemblyName>
    <RootNamespace>BiomeLords</RootNamespace>
    <Version>0.1.0</Version>
    <ValheimPath>C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimPath>
    <!-- Valheim 1.0 ships no BepInEx inside the Steam install (Gale keeps its own
         copy per profile), so BepInEx / Harmony / Jotunn are referenced from the
         Gale test profile rather than from $(ValheimPath). -->
    <GaleProfilePath>C:\Users\yesu0725\AppData\Roaming\com.kesomannen.gale\valheim\profiles\TG Mods Only</GaleProfilePath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Canvas / RectTransformUtility (storage-window drag math). -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.EventSystems drag handlers (storage-window drag). -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimPath)\valheim_Data\Managed\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GaleProfilePath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GaleProfilePath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>$(GaleProfilePath)\BepInEx\plugins\ValheimModding-Jotunn\Jotunn.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <!-- Client-side testing profiles (Gale). Replaced the old r2modman profiles. -->
    <GaleTestPluginPath>$(GaleProfilePath)\BepInEx\plugins\TaegukGaming-BiomeLords</GaleTestPluginPath>
    <GalePluginPath>C:\Users\yesu0725\AppData\Roaming\com.kesomannen.gale\valheim\profiles\HB Test\BepInEx\plugins\TaegukGaming-BiomeLords</GalePluginPath>
    <DedicatedServerPluginPath>C:\Program Files (x86)\Steam\steamapps\common\Valheim dedicated modded test server\BepInEx\plugins\TaegukGaming-BiomeLords</DedicatedServerPluginPath>
  </PropertyGroup>

  <!-- Deploy: the Gale "HB Test" profile and the local modded test dedicated server.
       Every other profile (TG Mods Only, r2modman) is left alone on purpose - copy by
       hand if a build is ever needed there. The server copy only warns on failure: a
       running server holds the DLL open (MSB3021), and that must not fail the build. -->
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <MakeDir Directories="$(GalePluginPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GalePluginPath)" />
    <Message Text="Copied $(TargetFileName) to Gale HB Test profile" Importance="high" />
    <MakeDir Directories="$(DedicatedServerPluginPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DedicatedServerPluginPath)" Retries="0" ContinueOnError="WarnAndContinue" />
    <Message Text="Copied $(TargetFileName) to modded test dedicated server" Importance="high" Condition="'$(MSBuildLastTaskResult)' == 'true'" />
  </Target>
</Project>
